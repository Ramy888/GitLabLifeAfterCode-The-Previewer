{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "the-previewer-lac",
          "appId": "1:57342278583:android:988aed2b4d8edc35be8632",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "the-previewer-lac",
          "appId": "1:57342278583:ios:8e7ce328109ce13dbe8632",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "the-previewer-lac",
          "appId": "1:57342278583:ios:8e7ce328109ce13dbe8632",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "the-previewer-lac",
          "configurations": {
            "android": "1:57342278583:android:988aed2b4d8edc35be8632",
            "ios": "1:57342278583:ios:8e7ce328109ce13dbe8632",
            "macos": "1:57342278583:ios:8e7ce328109ce13dbe8632",
            "web": "1:57342278583:web:ef2e54dcf3c13301be8632"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
